# Copy this file to .env and fill in real values. Never commit the real .env file.
# Used by docker-compose.yml to configure the postgres and backend services.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=limousine_booking

JWT_ISSUER=LimousineBooking
JWT_AUDIENCE=LimousineBooking
JWT_KEY=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=60
