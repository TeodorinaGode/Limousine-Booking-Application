# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection (used by the backend container / local dotnet run)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=limousine_booking;Username=postgres;Password=change-me

# JWT authentication (used to sign/validate driver & admin tokens)
# Note: ASP.NET Core's env-var config provider maps Jwt__SecretKey -> Jwt:SecretKey
# by exact (case-insensitive) property name, so the key must be "SecretKey", not
# "SECRET_KEY" with an extra underscore.
Jwt__Issuer=LimousineBooking
Jwt__Audience=LimousineBooking
Jwt__SecretKey=replace-with-a-long-random-secret
Jwt__AccessTokenExpirationMinutes=60

# Allowed frontend origin(s) for CORS
Cors__AllowedOrigins__0=http://localhost:5173

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
