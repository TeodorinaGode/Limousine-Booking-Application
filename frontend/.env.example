# Copy this file to .env and adjust as needed. Never commit the real .env file.

VITE_API_BASE_URL=http://localhost:5000/api

# Service-area map tile source (Prompt 19). CARTO's free dark basemap needs no
# API key — see README's Prompt 19 notes for why this provider was chosen and
# how to swap it for Mapbox/Google later without touching ServiceAreaMap's callers.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
