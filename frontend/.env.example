# Copy this file to .env and adjust as needed. Never commit the real .env file.

VITE_API_BASE_URL=http://localhost:5000/api

# Service-area map tile source (Prompt 19). Esri's World Dark Gray Canvas
# basemap needs no API key — see README's Prompt 19 notes for why this
# provider was chosen (CARTO's free anonymous tiles now require one) and how
# to swap it for Mapbox/Google later without touching ServiceAreaMap's callers.
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
